{
	"name": "resolve.imports",
	"version": "2.0.3",
	"description": "resolve \"imports\" in package.json",
	"keywords": [
		"esm",
		"imports",
		"esmodules",
		"fields",
		"modules",
		"resolution",
		"resolve"
	],
	"homepage": "https://github.com/cyberuni/resolve.imports",
	"bugs": {
		"url": "https://github.com/cyberuni/resolve.imports/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/resolve.imports.git",
		"directory": "packages/resolve.imports"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"import": "./esm/index.js",
			"default": "./cjs/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/testutils",
		"!cjs/**/*.d.ts",
		"!**/*.test.*",
		"!**/*.spec.*",
		"!**/*.unit.*",
		"!**/*.integrate.*",
		"!**/*.system.*",
		"!**/*.accept.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs esm coverage",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"watch": "vitest"
	},
	"dependencies": {
		"pattern-key-compare": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=20"
	}
}
